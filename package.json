{
  "name": "sonic-search",
  "version": "0.1.0",
  "private": true,
  "description": "Sonic Search web app packaged for iOS and Android with Capacitor.",
  "scripts": {
    "beta:check": "node scripts/check-beta-storage.mjs",
    "audit:electronic": "node scripts/audit-electronic-recommendations.mjs",
    "catalog:v2:generate": "node scripts/generate-electronic-catalog-v2-import.mjs",
    "catalog:v2:import": "node scripts/import-catalog-extra-remote.mjs --rows reports/catalog_extra_electronic_v2.rows.json --require-electronic-gate",
    "catalog:musicbrainz:generate": "node scripts/generate-musicbrainz-electronic-import.mjs",
    "catalog:expand-underrepresented": "node scripts/generate-underrepresented-subgenre-expansion-v18.mjs",
    "catalog:expand-low-coverage": "node scripts/generate-low-coverage-subgenre-expansion-v21.mjs",
    "catalog:runtime:build": "node scripts/build-runtime-catalog.mjs",
    "check": "node --check app.js",
    "web:build": "node scripts/build-web-assets.mjs",
    "ios:build-web": "node scripts/build-ios-web.mjs",
    "ios:copy": "node scripts/build-ios-web.mjs && node scripts/copy-ios-native.mjs && node scripts/test-ios-playback-bundle.mjs",
    "ios:sync": "node scripts/build-ios-web.mjs && cap sync ios",
    "ios:open": "node scripts/build-ios-web.mjs && node scripts/copy-ios-native.mjs && node scripts/test-ios-playback-bundle.mjs && open ios/App/App.xcodeproj",
    "android:build-web": "node scripts/build-android-web.mjs",
    "android:copy": "node scripts/build-android-web.mjs && node scripts/copy-android-native.mjs",
    "android:open": "node scripts/build-android-web.mjs && node scripts/copy-android-native.mjs && open -a \"Android Studio\" android",
    "android:bundle": "node scripts/build-android-web.mjs && node scripts/copy-android-native.mjs && cd android && ./gradlew bundleRelease",
    "appstore:smoke": "node scripts/appstore-public-smoke.mjs",
    "test:admin-access": "node scripts/test-admin-access.mjs",
    "test:membership": "node scripts/test-membership-foundation.mjs",
    "test:daily-radar": "node scripts/test-daily-radar.mjs",
    "test:billing": "node scripts/test-billing-foundation.mjs",
    "test:sound-system-premium": "node scripts/test-sound-system-premium.mjs",
    "test:weekly-highlights": "node scripts/test-weekly-highlights.mjs",
    "test:premium-visibility": "node scripts/test-premium-promo-visibility.mjs",
    "test:newsroom": "node scripts/test-newsroom.mjs",
    "test:newsroom-visuals": "node scripts/test-newsroom-visuals.mjs",
    "test:community-email": "node scripts/test-community-email-notifications.mjs",
    "test:ugc-safety": "node scripts/test-ugc-safety.mjs",
    "test:discovery-performance": "node scripts/test-discovery-performance.mjs",
    "test:first-impression": "node scripts/test-friendly-first-impression.mjs",
    "test:first-experience": "node scripts/test-first-experience.mjs",
    "test:taste-calibration": "node scripts/test-initial-taste-calibration.mjs",
    "test:catalog-expansion": "node scripts/test-underrepresented-catalog-expansion.mjs",
    "test:low-coverage-expansion": "node scripts/test-low-coverage-subgenre-expansion-v21.mjs",
    "test:auth-recommendation-isolation": "node scripts/test-auth-recommendation-isolation.mjs",
    "test:opening-rotation": "node scripts/test-opening-rotation.mjs",
    "test:dj-player-swipe": "node scripts/test-dj-player-swipe.mjs",
    "test:daily-djs": "node scripts/test-daily-djs.mjs",
    "test:unlimited-likes": "node scripts/test-daily-like-limit.mjs",
    "test:daily-like-limit": "node scripts/test-daily-like-limit.mjs",
    "test:ios-playback-bundle": "node scripts/test-ios-playback-bundle.mjs",
    "test:psytrance-integrity": "node scripts/test-psytrance-integrity.mjs",
    "test:subgenre-stress": "node scripts/test-subgenre-stress.mjs",
    "test:niche-stress": "node scripts/test-niche-subgenre-stress.mjs",
    "audit:low-coverage": "node scripts/audit-low-coverage-subgenres-v21.mjs",
    "test:recommendation-safety": "node scripts/test-recommendation-safety.mjs",
    "test:android-runtime": "node scripts/test-android-runtime.mjs",
    "supabase:apple-auth": "node scripts/configure-supabase-apple-auth.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "clean-css": "^5.3.3",
    "terser": "^5.49.0"
  }
}
